# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Geocoding (server-side only — used to compute the real address, then jitter it)
GEOCODING_API_KEY=

# Google Search Console / Indexing (for the sitemap_status monitoring job)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Site
NEXT_PUBLIC_SITE_URL=https://www.hertsroofingnj.com

# Optional — shown as a click-to-call link after someone submits the lead
# form on a project page. Leave blank to just show the thank-you message
# with no phone number.
NEXT_PUBLIC_BUSINESS_PHONE=

# CompanyCam — generate at CompanyCam > Company Settings > API Keys
COMPANYCAM_API_KEY=

# CompanyCam webhook — pick any long random string yourself, put the same
# value in the webhook's subscription URL as ?secret=<this>
COMPANYCAM_WEBHOOK_SECRET=

# Admin login (protects everything under /admin) — pick your own values,
# both required for /admin/login to work.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Claude API key — used by the "Generate with AI" button on imported drafts
# to draft page content, and to draft review replies.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Review sync — pick any long random string yourself. Whatever pulls your
# Google reviews in (a Claude-run sync, a script) posts to
# /api/reviews/import?secret=<this>, so it needs the same value.
REVIEWS_SYNC_SECRET=
