# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Geocoding (server-side only — used to compute the real address, then jitter it)
GEOCODING_API_KEY=

# Google Search Console / Indexing (for the sitemap_status monitoring job)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Site
NEXT_PUBLIC_SITE_URL=https://www.hertsroofingnj.com

# CompanyCam — generate at CompanyCam > Company Settings > API Keys
COMPANYCAM_API_KEY=

# CompanyCam webhook — pick any long random string yourself, put the same
# value in the webhook's subscription URL as ?secret=<this>
COMPANYCAM_WEBHOOK_SECRET=
